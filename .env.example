# Varsayılan olarak uygulama projenin Supabase'ine bağlanır (src/lib/supabase.ts).
# Başka bir Supabase projesi kullanmak için doldur. Hesapsız (yalnızca yerel) mod için VITE_SUPABASE_URL=off yaz.
# Buraya yalnızca publishable (sb_publishable_…) ya da anon anahtarı yaz; secret/service_role anahtarını asla.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
